# 产品默认：Mac 只调用远程 Gateway，不保存 DashScope API Key。
APP_MODE=real
INTERPRETER_MODE=remote
AI_GATEWAY_BASE_URL=https://gridworks.cn/tool/ai-interpreter-api
AI_GATEWAY_TOKEN=

# 仅 INTERPRETER_MODE=local 开发回退时使用；产品模式保持为空。
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=beijing
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_HTTP_BASE_URL=
DASHSCOPE_WEBSOCKET_BASE_URL=

ASR_PROVIDER=dashscope
ASR_MODEL=paraformer-realtime-v2

TRANSLATION_PROVIDER=dashscope
TRANSLATION_MODEL=qwen-mt-flash
SOURCE_LANGUAGE=zh
TARGET_LANGUAGE=en

TTS_PROVIDER=dashscope
TTS_MODEL=cosyvoice-v3-flash
# 留空时使用 cosyvoice-v3-flash 的英文兼容系统音色 longanyang
TTS_VOICE=
CLONED_VOICE_ID=

AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
KEEP_TEMP_AUDIO=false
LOG_LEVEL=INFO
NETWORK_TIMEOUT_SECONDS=45
