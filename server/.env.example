APP_ENV=production
LOG_LEVEL=INFO

DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_NATIVE_BASE_URL=
DASHSCOPE_COMPATIBLE_BASE_URL=

ASR_MODEL=paraformer-v2
STREAM_ASR_MODEL=paraformer-realtime-v2
TRANSLATION_MODEL=qwen-mt-flash
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longanyang
CLONED_VOICE_ID=

CLIENT_TEST_TOKEN=

MAX_UPLOAD_MB=20
MAX_CONCURRENT_REQUESTS=2
AUDIO_TTL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=120
TEMP_AUDIO_DIR=/tmp/ai-voice-interpreter

STREAMING_ENABLED=true
STREAMING_PROTOCOL_VERSION=1.0
STREAMING_MAX_SESSION_SECONDS=3600
STREAMING_MAX_CONNECTIONS=2
STREAMING_MAX_CONNECTIONS_PER_TOKEN=1
STREAMING_HEARTBEAT_SECONDS=20
STREAMING_HEARTBEAT_TIMEOUT_SECONDS=60
STREAMING_MAX_FRAME_BYTES=65536
STREAM_AUDIO_SAMPLE_RATE=16000
STREAM_AUDIO_CHANNELS=1
STREAM_AUDIO_CHUNK_MS=100
STREAM_AUDIO_QUEUE_MAX_CHUNKS=50
VAD_ENABLED=true
VAD_FRAME_MS=20
VAD_AGGRESSIVENESS=2
VAD_MIN_SPEECH_MS=250
VAD_SILENCE_MS=650
VAD_PRE_ROLL_MS=200
VAD_MAX_TURN_MS=15000
TTS_TEXT_MIN_CHARS=20
TTS_TEXT_TARGET_CHARS=48
TTS_TEXT_MAX_CHARS=90
TTS_TEXT_MAX_WAIT_MS=300
STREAM_TURN_QUEUE_MAX=3
STREAM_TTS_TEXT_QUEUE_MAX=10
STREAM_TTS_AUDIO_QUEUE_MAX_CHUNKS=100

# Phase 2.1 primary streaming pipeline. Invalid values make /readyz not ready.
STREAM_PIPELINE_PROVIDER=livetranslate
STREAM_PIPELINE_FALLBACK_PROVIDER=modular
ALLOW_STREAM_PIPELINE_OVERRIDE=false

LIVETRANSLATE_MODEL=qwen3.5-livetranslate-flash-realtime
LIVETRANSLATE_SOURCE_LANGUAGE=zh
LIVETRANSLATE_TARGET_LANGUAGE=en
LIVETRANSLATE_OUTPUT_MODALITIES=text,audio
LIVETRANSLATE_VOICE=Tina
LIVETRANSLATE_ENABLE_SOURCE_TRANSCRIPTION=true
LIVETRANSLATE_SOURCE_ASR_MODEL=qwen3-asr-flash-realtime
LIVETRANSLATE_SOURCE_TRANSCRIPTION_FALLBACK=none
LIVETRANSLATE_ENABLE_VOICE_CLONE=false
LIVETRANSLATE_VOICE_CLONE_FREQUENCY=once
LIVETRANSLATE_CONNECT_TIMEOUT_SECONDS=15
LIVETRANSLATE_SESSION_FINISH_TIMEOUT_SECONDS=20
LIVETRANSLATE_AUDIO_QUEUE_MAX_CHUNKS=100
LIVETRANSLATE_HOTWORDS_JSON={"项目进度":"project progress","交付计划":"delivery plan"}
